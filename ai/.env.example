# CoverWise AI - AI/ML Module Environment Configuration

# Ollama / LLM Settings (configurable model, e.g., qwen2.5:7b or qwen2.5:14b)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60

# Embeddings & Vector Database Settings (BGE-M3 1024 dimensions)
EMBEDDING_MODEL=BAAI/bge-m3
DATABASE_URL=postgresql://username:password@localhost:5432/coverwise
VECTOR_TABLE_NAME=policy_embeddings
VECTOR_DIMENSION=1024

# Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Extraction & OCR Settings (OCR is strictly optional)
ENABLE_OCR=false
OCR_ENGINE=paddleocr

# Application & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO
