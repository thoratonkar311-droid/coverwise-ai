# CoverWise AI - Production Environment Variables Example
# Copy this file to .env.production or set these in your deployment platform (e.g. AWS, Render, Railway, Fly.io)

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:STRONG_SECURE_PASSWORD@your-db-host:5432/coverwise

# Backend Security
SECRET_KEY=generate_a_64_character_random_hex_key_here
ENVIRONMENT=production
LOG_LEVEL=INFO

# CORS Configuration (comma-separated domains of your frontend)
ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# LLM / Ollama Configuration (Local Ollama or remote LLM service)
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=60

# Frontend Configuration
# Leave NEXT_PUBLIC_API_URL empty if using Next.js proxy rewrites to BACKEND_URL
NEXT_PUBLIC_API_URL=
BACKEND_URL=http://backend:8000
